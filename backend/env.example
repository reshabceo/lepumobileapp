# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Bluetooth Configuration
BLE_SCAN_TIMEOUT=30000
BLE_CONNECTION_TIMEOUT=10000

# API Configuration
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY_SECRET=your-api-key-secret

# Rate Limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes
RATE_LIMIT_MAX=100        # requests per window

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Database (Optional - for storing device data)
MONGODB_URL=mongodb://localhost:27017/medical_devices
REDIS_URL=redis://localhost:6379

# Razorpay (patient payments: appointment, radiologist review, emergency)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
# Prices in paise (100 paise = ₹1). Optional; defaults: video ₹500, audio ₹300, emergency ₹1000
# APPOINTMENT_VIDEO_PAISE=50000
# APPOINTMENT_AUDIO_PAISE=30000
# EMERGENCY_PAISE=100000

# Supabase (for fulfilling after payment - create appointment/radiologist_requests/emergency_alerts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
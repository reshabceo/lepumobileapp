<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/view_divider" />
            <corners android:bottomLeftRadius="@dimen/margin4dp"
                android:bottomRightRadius="@dimen/margin4dp" />
        </shape>
    </item>
    <item android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/recording_primary_border" />
            <corners android:bottomLeftRadius="@dimen/margin4dp"
                android:bottomRightRadius="@dimen/margin4dp" />
        </shape>
    </item>
</layer-list>

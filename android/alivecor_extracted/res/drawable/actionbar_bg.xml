<?xml version="1.0" encoding="utf-8"?>
<!--
    Background for some "fake" actionbars/cards.  This version has a sort-of shadow under the bar.
    There is a -v21 version of this drawable that does not have the shadow.  Instead, the View can
    have elevation set.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle" >
            <solid android:color="@color/actionbar_bg_solid" />
        </shape>
    </item>

    <item android:top="@dimen/negative_actionbar_underscore_height_minus_1"
        android:right="@dimen/negative_actionbar_underscore_height_minus_1"
        android:left="@dimen/negative_actionbar_underscore_height_minus_1">
        <shape>
            <stroke
                android:width="@dimen/actionbar_underscore_height"
                android:color="@color/actionbar_bg_shadow" />
            <solid android:color="@color/transparent_color" />
        </shape>
    </item>

</layer-list>

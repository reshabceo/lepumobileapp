<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true"
        >
        <shape>
            <solid android:color="@color/munsell_a80"/>
            <corners
                android:radius="@dimen/teal_btn_corner_radius"/>
            <stroke
                android:color="@color/pale_aqua"
                android:width="1dp"
                />
        </shape>
    </item>

    <item android:state_enabled="false"
        >
        <shape>
            <solid android:color="@color/kardia_teal_control_disabled"/>
            <corners
                android:radius="@dimen/teal_btn_corner_radius"/>
            <stroke
                android:color="@color/pale_aqua"
                android:width="1dp"
                />
        </shape>
    </item>

    <item
        >
        <shape>
            <solid android:color="@color/munsell_a19"/>
            <corners
                android:radius="@dimen/teal_btn_corner_radius"/>
            <stroke
                android:color="@color/pale_aqua"
                android:width="1dp"
                />
        </shape>
    </item>

</selector>
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle" >
            <solid android:color="@color/actionbar_bg_solid" />
        </shape>
    </item>

    <item android:bottom="@dimen/negative_actionbar_underscore_height_minus_1"
        android:right="@dimen/negative_actionbar_underscore_height_minus_1"
        android:left="@dimen/negative_actionbar_underscore_height_minus_1">
        <shape>
            <stroke
                android:width="@dimen/actionbar_underscore_height"
                android:color="@color/actionbar_bg_shadow" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:endColor="@color/kardia_teal_gradient_dark" android:startColor="@color/kardia_teal_gradient_light" />
                    <corners android:radius="20dp" />
                </shape>
            </item>

            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape>
                    <solid android:color="@color/white"/>
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>

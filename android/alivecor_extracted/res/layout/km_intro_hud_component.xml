<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/km_intro_hud_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recording_intro_middle"
        android:textAppearance="@style/Text.a"
        android:textSize="@dimen/text_size_lbl"
        app:layout_constraintBottom_toTopOf="@id/barrier"
        app:layout_constraintEnd_toEndOf="@id/km_intro_hud_device_top"
        app:layout_constraintStart_toStartOf="@id/km_intro_hud_device_top"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/km_intro_hud_pointer_tip"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/circle_kardia_teal_light"
        app:layout_constraintBottom_toTopOf="@id/km_intro_hud_pointer"
        app:layout_constraintEnd_toEndOf="@id/km_intro_hud_device_top"
        app:layout_constraintStart_toStartOf="@id/km_intro_hud_device_top"
        app:layout_constraintTop_toBottomOf="@id/km_intro_hud_middle" />


    <ImageView
        android:id="@+id/km_intro_hud_device_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/kmobile_hud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/km_intro_hud_pointer_tip" />

    <View
        android:id="@+id/km_intro_hud_pointer"
        android:layout_width="1dp"
        android:layout_height="38dp"
        android:background="@color/kardia_teal_light"
        app:layout_constraintEnd_toEndOf="@id/km_intro_hud_device_top"
        app:layout_constraintStart_toStartOf="@id/km_intro_hud_device_top"
        app:layout_constraintTop_toBottomOf="@id/km_intro_hud_pointer_tip" />

    <TextView
        android:id="@+id/km_intro_hud_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="4dp"
        android:text="@string/recording_intro_left"
        android:textAppearance="@style/Text.a"
        android:textSize="@dimen/text_size_lbl"
        app:layout_constraintBottom_toTopOf="@id/km_intro_hud_device_top"
        app:layout_constraintEnd_toStartOf="@id/km_intro_hud_pointer"
        app:layout_constraintStart_toStartOf="@id/km_intro_hud_device_top" />

    <TextView
        android:id="@+id/km_intro_hud_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="22dp"
        android:gravity="end"
        android:text="@string/recording_intro_right"
        android:textAppearance="@style/Text.a"
        android:textSize="@dimen/text_size_lbl"
        app:layout_constraintBottom_toTopOf="@id/km_intro_hud_device_top"
        app:layout_constraintEnd_toEndOf="@id/km_intro_hud_device_top"
        app:layout_constraintStart_toEndOf="@id/km_intro_hud_pointer" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="km_intro_hud_right,km_intro_hud_left,km_intro_hud_pointer_tip" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical">

    <include
        android:id="@+id/layout_kardia_card_no_device"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/no_device_selected_kardia_card"
        android:visibility="visible"/>

    <include
        android:id="@+id/layout_kardia_card_default_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/default_state_kardia_card"
        android:visibility="gone"/>

    <include
        android:id="@+id/layout_kardia_card_recorded_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/recording_state_kardia_card"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>

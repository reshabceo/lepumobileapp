<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical|center_horizontal"
    android:background="@color/kardia_bg_white"
    android:elevation="@dimen/margin16dp"
    android:visibility="visible"
    app:cardCornerRadius="@dimen/margin8dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin16dp">

        <TextView
            android:id="@+id/title"
            style="@style/KardiaTextH6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/turn_on_your_kardiamobile_card_device"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/img_kardia_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.14" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/pin_line_guideline_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.40" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/pin_line_guideline_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.65" />

            <TextView
                android:id="@+id/power_button_tv"
                style="@style/KardiaTextH4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin4dp"
                android:gravity="center"
                android:maxWidth="@dimen/width_textview"
                android:text="@string/power_button"
                android:textColor="@color/kardia_spruce"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/pin_line_guideline_right"
                app:layout_constraintStart_toStartOf="@id/pin_line_guideline_right"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/amber_light_tv"
                style="@style/KardiaTextH4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/width_textview"
                android:text="@string/amber_light"
                android:paddingEnd="11dp"
                android:textColor="@color/kardia_spruce"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/guideline"
                app:layout_constraintEnd_toStartOf="@id/pin_line_guideline_left"
                app:layout_constraintTop_toTopOf="@id/guideline" />

            <ImageView
                android:id="@+id/kc_hud_img"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_kardia_card"
                android:src="@drawable/card_img_with_pins"
                app:layout_constraintTop_toBottomOf="@id/power_button_tv" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/btn_view_tutorial"
            style="@style/KardiaButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height41dp"
            android:background="@drawable/button_white_with_black_border"
            android:text="@string/view_tutorial"
            app:layout_constraintTop_toBottomOf="@id/img_kardia_card" />

        <Button
            android:id="@+id/btn_contact_support"
            style="@style/KardiaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintHeight_max="@dimen/height41dp"
            android:layout_marginTop="@dimen/margin8dp"
            android:background="@drawable/button_gray"
            android:text="@string/contact_support"
            app:layout_constraintTop_toBottomOf="@id/btn_view_tutorial" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

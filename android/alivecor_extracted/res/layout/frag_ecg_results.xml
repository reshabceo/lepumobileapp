<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frag_ecg_results"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/munsell"
    android:orientation="vertical">

    <!-- header -->
    <LinearLayout
        android:id="@+id/frag_ecg_results_header_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="8dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:src="@drawable/kardia_logo_short" />

        <ImageView
            android:id="@+id/frag_ecg_result_done"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/img_bkg_btn_general"
            android:scaleType="centerInside"
            android:src="@drawable/ic_done_black_24dp"
            app:tint="@color/kardia_teal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_screen_result_band_with_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/result_screen_green"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frag_ecg_results_header_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frag_ecg_result_result_band"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="17dp">

            <TextView
                android:id="@+id/frag_ecg_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="@dimen/ecg_result_title_max_width"
                android:maxLines="2"
                android:textAppearance="@style/Text.h1.1"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/frag_ecg_result_determination_info"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Sinus Rhythm" />

            <ImageView
                android:id="@+id/frag_ecg_result_determination_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/information_md"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/frag_ecg_result_title"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/frag_ecg_result_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="8dp"
                android:textAppearance="@style/Text.h1.1"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="288 BPM" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/frag_ecg_results_modifier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginStart="17dp"
            android:visibility="gone"
            android:textAppearance="@style/Text.lbl"
            tools:text="Line 2"
            />

    </LinearLayout>


    <FrameLayout
        android:id="@+id/frag_ecg_result_ecg_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/more_options_down_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_screen_result_band_with_description">

        <com.alivecor.ecg.record.EcgStripView
            android:id="@+id/frag_ecg_result_ecgview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:minHeight="@dimen/ecg_results_strip_h" />

        <LinearLayout
            android:id="@+id/inverted_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/img_bkg_gradient_gray90_gray40_24"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/frag_ecg_results_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="25 mm/s"
                android:textColor="@color/text_color_dark"
                android:textSize="@dimen/text_size_smaller" />

            <TextView
                android:id="@+id/frag_ecg_results_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:text="10 mm/mV"
                android:textColor="@color/text_color_dark"
                android:textSize="@dimen/text_size_smaller" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/frag_ecg_results_invert_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="60dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/frag_ecg_results_invert_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/ecg_results_invert"
                    android:textColor="@color/text_color_dark"
                    android:textSize="@dimen/text_size_smaller" />

                <TextView
                    android:id="@+id/frag_ecg_results_invert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="8dp"
                    android:text="@string/ecg_results_invert_off"
                    android:textColor="@color/kardia_teal"
                    android:textSize="@dimen/text_size_smaller" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/bottom_view_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:constraint_referenced_ids="bottom_view" />

    <FrameLayout
        android:id="@+id/more_options_down_layout"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@color/munsell"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#d8d8d8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/more_options_down_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/chevron_up" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:id="@+id/bottom_view"
        android:background="@color/munsell"
        android:layout_marginTop="@dimen/ecg_results_strip_h"
        app:layout_constraintTop_toTopOf="@id/frag_ecg_result_ecg_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/more_options_up_layout"
                android:layout_width="match_parent"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/more_options_up_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/chevron_down" />
            </FrameLayout>

            <TextView
                android:id="@+id/frag_ecg_result_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:layout_marginBottom="12dp"
                android:gravity="start"
                android:textAppearance="@style/Text.b"
                android:textSize="16sp"
                tools:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry." />

            <TextView
                android:id="@+id/frag_ecg_result_learn_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginStart="17dp"
                android:paddingTop="4dp"
                android:layout_marginEnd="17dp"
                android:layout_marginBottom="10dp"
                android:paddingBottom="8dp"
                android:gravity="center"
                android:text="@string/learn_more"
                android:textAppearance="@style/Text.a"
                android:textColor="@color/black"
                android:drawableEnd="@drawable/ic_chevron_right"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/frag_ecg_result_result_band" />

            <TextView
                android:id="@+id/frag_ecg_result_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:layout_marginBottom="8dp"
                android:gravity="start"
                android:scrollbars="vertical"
                android:textSize="12sp"
                tools:text="*Lorem Ipsum is simply dummy text of the printing\nand typesetting industry. Lorem Ipsum has\nbeen the industry." />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rect_r27_munsell_gradient"
    android:orientation="vertical">

    <TextView
        android:id="@+id/recording_hud_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="29dp"
        android:layout_marginTop="@dimen/insights_margin_2"
        android:layout_marginEnd="29dp"
        android:gravity="center"
        android:text="@string/recording_intro_km_title"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/recording_hud_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/recording_hud_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="29dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="29dp"
        android:gravity="center"
        android:text="@string/recording_intro_tr6lead_body"
        android:textColor="@color/translucent_black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/hud_component"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recording_hud_header" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hud_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="29dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="29dp"
        app:layout_constraintBottom_toTopOf="@id/triangle_intro_hud_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recording_hud_desc"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:id="@+id/triangle_intro_hud_middle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recording_intro_middle"
            android:textAppearance="@style/Text.a"
            android:textSize="@dimen/text_size_lbl"
            app:layout_constraintBottom_toTopOf="@id/triangle_intro_hud_pointer_tip"
            app:layout_constraintEnd_toEndOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintStart_toStartOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/triangle_intro_hud_pointer_tip"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_kardia_teal_light"
            app:layout_constraintBottom_toTopOf="@id/triangle_intro_hud_pointer"
            app:layout_constraintEnd_toEndOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintStart_toStartOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintTop_toBottomOf="@id/triangle_intro_hud_middle" />


        <ImageView
            android:id="@+id/triangle_intro_hud_device_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/triangle_hud_top_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/triangle_intro_hud_pointer_tip" />

        <View
            android:id="@+id/triangle_intro_hud_pointer"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/kardia_teal_light"
            app:layout_constraintEnd_toEndOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintStart_toStartOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintTop_toBottomOf="@id/triangle_intro_hud_pointer_tip" />

        <TextView
            android:id="@+id/triangle_intro_hud_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recording_intro_left"
            android:layout_marginEnd="@dimen/margin16dp"
            android:textAppearance="@style/Text.a"
            android:textSize="@dimen/text_size_lbl"
            app:layout_constraintBottom_toTopOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintEnd_toStartOf="@id/triangle_intro_hud_pointer_tip" />

        <TextView
            android:id="@+id/triangle_intro_hud_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin16dp"
            android:text="@string/recording_intro_right"
            android:textAppearance="@style/Text.a"
            android:textSize="@dimen/text_size_lbl"
            app:layout_constraintBottom_toTopOf="@id/triangle_intro_hud_device_top"
            app:layout_constraintStart_toEndOf="@id/triangle_intro_hud_pointer_tip" />


        <TextView
            android:id="@+id/triangle_intro_hud_bottom_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="@string/recording_intro_bottom"
            android:textAppearance="@style/Text.a"
            android:textSize="@dimen/text_size_lbl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/triangle_intro_hud_device_top" />

        <ImageView
            android:id="@+id/triangle_intro_hud_device_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:src="@drawable/triangle_hud_bottom_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/triangle_intro_hud_bottom_label" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/triangle_intro_hud_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        android:layout_marginBottom="@dimen/insights_margin_4"
        android:gravity="center"
        android:text="@string/i_need_help"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:drawableEnd="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

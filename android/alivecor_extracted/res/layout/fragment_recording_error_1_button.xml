<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rect_r27_munsell_gradient">

    <TextView
        android:id="@+id/recording_error_1_btn_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/recording_intro_km_title"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"/>

    <TextView
        android:id="@+id/recording_error_1_btn_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/recording_intro_km_body"
        android:textColor="@color/translucent_black"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/recording_error_1_btn_title"
        android:layout_marginTop="@dimen/insights_margin_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"/>

    <TextView
        android:id="@+id/recording_error_1_btn_help"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:drawableEnd="@drawable/ic_chevron_right"
        android:gravity="center"
        android:text="@string/i_need_help"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="14dp"/>

    <TextView
        android:id="@+id/recording_error_1_btn_button"
        style="@style/kardia_btn_primary"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bkg_btn_teal_gradient_corners_r20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/recording_error_1_btn_help"
        tools:text="Go to Settings"
        android:layout_marginStart="29dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="29dp"/>

   <ImageView
        android:id="@+id/recording_error_1_btn_icon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        app:layout_constraintTop_toBottomOf="@id/recording_error_1_btn_message"
        app:layout_constraintBottom_toTopOf="@id/recording_error_1_btn_button"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="29dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="29dp"
        tools:src="@drawable/nfc_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>

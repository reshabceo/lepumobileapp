<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.record.ekg.RecordingSentFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/dp_16" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuideline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/dp_16" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/closeIV"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/bg_close_button"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="@id/endGuideline"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_32"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/completeBtn"
        app:layout_constraintTop_toBottomOf="@+id/closeIV">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recordingSentTitle"
                style="@style/KiwiHeader.H2.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"
                android:text="@string/recording_sent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recordingSentDesc"
                style="@style/KiwiHeader"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/recording_sent_desc"
                app:layout_constraintEnd_toEndOf="@id/recordingSentTitle"
                app:layout_constraintStart_toStartOf="@id/recordingSentTitle"
                app:layout_constraintTop_toBottomOf="@id/recordingSentTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                app:cardCornerRadius="@dimen/dp_8"
                app:cardElevation="@dimen/dp_8"
                app:layout_constraintEnd_toEndOf="@id/recordingSentTitle"
                app:layout_constraintStart_toStartOf="@id/recordingSentTitle"
                app:layout_constraintTop_toBottomOf="@id/recordingSentDesc">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/ekgDetailsHeader"
                        style="@style/KiwiSpacedCaptionNormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ekg_details"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/dateStatic"
                        style="@style/KiwiHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/date"
                        app:layout_constraintTop_toBottomOf="@id/ekgDetailsHeader" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/date"
                        style="@style/KiwiBoldHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        app:layout_constraintTop_toBottomOf="@id/dateStatic"
                        tools:text="01/01/2021" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/timeStatic"
                        style="@style/KiwiHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/time"
                        app:layout_constraintTop_toBottomOf="@id/date" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/time"
                        style="@style/KiwiBoldHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        app:layout_constraintTop_toBottomOf="@id/timeStatic"
                        tools:text="08:00 AM" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/symptomsStatic"
                        style="@style/KiwiHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/symptoms"
                        app:layout_constraintTop_toBottomOf="@id/time" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/symptom"
                        style="@style/KiwiBoldHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        app:layout_constraintTop_toBottomOf="@id/symptomsStatic"
                        tools:text="Trouble breathing, change in heart rate" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/activityStatic"
                        style="@style/KiwiHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/activity"
                        app:layout_constraintTop_toBottomOf="@id/symptom" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/activity"
                        style="@style/KiwiBoldHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        app:layout_constraintTop_toBottomOf="@id/activityStatic"
                        tools:text="Other: About 30 mins after I jogged this morning." />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/completeBtn"
        style="@style/Full.Blue.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_32"
        android:text="@string/complete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/endGuideline"
        app:layout_constraintStart_toEndOf="@id/startGuideline" />

</androidx.constraintlayout.widget.ConstraintLayout>

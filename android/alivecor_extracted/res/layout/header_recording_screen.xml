<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/header_recording_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/margin8dp">

    <ImageView
        android:id="@+id/convert_actionbar_back"
        android:layout_width="@dimen/margin40dp"
        android:layout_height="@dimen/margin40dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_action_close_button"
        app:layout_constraintBottom_toBottomOf="@+id/spinner_select_device"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spinner_select_device" />

    <ImageView
        android:id="@+id/convert_actionbar_right_img"
        android:layout_width="@dimen/margin24dp"
        android:layout_height="@dimen/margin24dp"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/margin26dp"
        android:src="@drawable/settings_button_teal_gradient"
        app:layout_constraintBottom_toBottomOf="@+id/spinner_select_device"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spinner_select_device" />

    <Spinner
        android:id="@+id/spinner_select_device"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/margin26dp"
        android:layout_marginTop="@dimen/margin24dp"
        android:layout_marginEnd="@dimen/margin16dp"
        android:gravity="center|left"
        android:background="@drawable/spinner_border"
        android:dropDownVerticalOffset="@dimen/margin8dp"
        app:layout_constraintEnd_toStartOf="@+id/convert_actionbar_back"
        app:layout_constraintStart_toEndOf="@+id/convert_actionbar_right_img"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_select_device"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin16dp"
        android:layout_marginTop="@dimen/margin16dp"
        android:background="@color/white"
        android:text="@string/selected_device"
        android:textColor="@color/medium_jungle_green"
        android:textSize="@dimen/text_size_12sp"
        app:layout_constraintStart_toStartOf="@+id/spinner_select_device"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/select_device_balloon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/spinner_select_device"
        app:layout_constraintEnd_toEndOf="@id/spinner_select_device"
        app:layout_constraintTop_toTopOf="@id/tv_select_device"
        app:layout_constraintBottom_toBottomOf="@+id/spinner_select_device"></View>

</androidx.constraintlayout.widget.ConstraintLayout>
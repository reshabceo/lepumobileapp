<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingStart="@dimen/kardia_margin"
    android:paddingEnd="@dimen/kardia_margin"
    android:paddingBottom="@dimen/kardia_margin"
    tools:context=".determination.DeterminationDetailsActivity">

    <include
        android:id="@+id/determination_details_toolbar"
        layout="@layout/layout_rec_determination_details_toolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/determination_details_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="76dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/determination_details_toolbar"
        tools:listitem="@layout/row_rec_determination_details"/>

    <include
        android:visibility="gone"
        android:id="@+id/determination_details_unreadable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        layout="@layout/layout_rec_determination_details_unreadable"
        app:layout_constraintTop_toBottomOf="@id/determination_details_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

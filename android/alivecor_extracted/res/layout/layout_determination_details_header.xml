<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <TextView
        android:id="@+id/determination_details_title"
        style="@style/Kardia.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/determination_details"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/determination_details_view"
        android:layout_width="8dp"
        android:layout_height="0dp"
        android:background="@color/analysis_none"
        app:layout_constraintBottom_toBottomOf="@id/determination_details_header_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/determination_details_header_tv" />

    <TextView
        android:id="@+id/determination_details_header_tv"
        style="@style/Kardia.Header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:text="@string/summary_unread"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/determination_details_view"
        app:layout_constraintTop_toBottomOf="@id/determination_details_title" />

</androidx.constraintlayout.widget.ConstraintLayout>

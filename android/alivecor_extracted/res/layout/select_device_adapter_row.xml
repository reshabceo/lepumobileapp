<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin16dp"
        android:layout_marginTop="@dimen/margin12dp"
        android:layout_marginEnd="@dimen/margin16dp"
        android:layout_marginBottom="@dimen/margin12dp"
        android:textColor="@color/medium_jungle_green"
        android:textSize="@dimen/text_size_16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_add_new_device"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/icon_add_new_device"
        android:layout_width="@dimen/margin20dp"
        android:layout_height="@dimen/margin20dp"
        android:layout_marginStart="@dimen/margin16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_device_name"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_add_new_device_icon" />

    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="@dimen/margin1dp"
        android:layout_marginStart="@dimen/margin8dp"
        android:layout_marginTop="@dimen/margin12dp"
        android:layout_marginEnd="@dimen/margin8dp"
        android:background="@color/spinner_separator_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_name" />
</androidx.constraintlayout.widget.ConstraintLayout>

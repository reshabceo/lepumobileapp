<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kardia_white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kardia_white">

        <include
            android:id="@+id/determination_details_unreadable_header"
            layout="@layout/layout_determination_details_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/determination_details_unreadable_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_24"
            android:text="@string/determination_details_unreadable_desc"
            app:layout_constraintTop_toBottomOf="@id/determination_details_unreadable_header" />

        <TextView
            android:id="@+id/point_1"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_1_desc" />

        <TextView
            android:id="@+id/point_1_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="@dimen/margin_24"
            android:text="@string/determination_details_unreadable_point_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_1"
            app:layout_constraintTop_toBottomOf="@id/determination_details_unreadable_desc" />

        <TextView
            android:id="@+id/point_2"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_2_desc" />

        <TextView
            android:id="@+id/point_2_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_2"
            app:layout_constraintTop_toBottomOf="@id/point_1_desc" />

        <TextView
            android:id="@+id/point_3"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_3_desc" />

        <TextView
            android:id="@+id/point_3_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_3"
            app:layout_constraintTop_toBottomOf="@id/point_2_desc" />

        <TextView
            android:id="@+id/point_4"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_4_desc" />

        <TextView
            android:id="@+id/point_4_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_4"
            app:layout_constraintTop_toBottomOf="@id/point_3_desc" />

        <TextView
            android:id="@+id/point_5"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_5_desc" />

        <TextView
            android:id="@+id/point_5_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_5"
            app:layout_constraintTop_toBottomOf="@id/point_4_desc" />

        <TextView
            android:id="@+id/point_6"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_6_desc" />

        <TextView
            android:id="@+id/point_6_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_6"
            app:layout_constraintTop_toBottomOf="@id/point_5_desc" />

        <Button
            android:id="@+id/determination_details_unreadable_learn_more"
            style="@style/KardiaButtonH1.BlackBorder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/learn_more"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/point_6_desc"
            app:layout_constraintTop_toBottomOf="@id/point_6_desc" />

        <TextView
            android:id="@+id/point_7"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_7_desc" />

        <TextView
            android:id="@+id/point_7_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_7"
            app:layout_constraintTop_toBottomOf="@id/determination_details_unreadable_learn_more" />

        <TextView
            android:id="@+id/point_8"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_8_desc" />

        <TextView
            android:id="@+id/point_8_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_8"
            app:layout_constraintTop_toBottomOf="@id/point_7_desc" />

        <TextView
            android:id="@+id/point_9"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/point_9_desc" />

        <TextView
            android:id="@+id/point_9_desc"
            style="@style/KardiaPurchasePrompt.Description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/determination_details_unreadable_point_9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/point_9"
            app:layout_constraintTop_toBottomOf="@id/point_8_desc" />

        <TextView
            style="@style/KardiaDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/potential_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/point_9_desc"
            app:layout_constraintVertical_bias="0.98" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

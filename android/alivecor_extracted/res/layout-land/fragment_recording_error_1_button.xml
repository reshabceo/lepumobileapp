<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rect_r27_munsell_gradient">

    <TextView
        android:id="@+id/recording_error_1_btn_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="@string/recording_intro_km_title"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/insights_margin_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/container"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"/>

    <TextView
        android:id="@+id/recording_error_1_btn_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="@string/recording_intro_km_body"
        android:textColor="@color/translucent_black"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/recording_error_1_btn_title"
        app:layout_constraintBottom_toTopOf="@id/recording_error_1_btn_help"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/container"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"/>

    <TextView
        android:id="@+id/recording_error_1_btn_help"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:drawableEnd="@drawable/ic_chevron_right"
        android:gravity="start"
        android:text="@string/i_need_help"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/insights_margin_2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"/>

    <include layout="@layout/recording_error_hud_component"
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="29dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>

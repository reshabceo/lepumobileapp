<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rect_r27_munsell_gradient"
    android:orientation="horizontal">


        <TextView
            android:id="@+id/recording_error_2_btn_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="29dp"
            app:layout_constraintEnd_toStartOf="@id/recording_error_2_btn_button_positive"
            android:layout_marginEnd="29dp"
            android:layout_marginTop="12dp"
            android:gravity="start"
            android:text="@string/recording_intro_km_title"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recording_error_2_btn_message"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recording_error_2_btn_title"
            app:layout_constraintBottom_toTopOf="@id/recording_error_2_btn_help"
            app:layout_constraintEnd_toStartOf="@id/recording_error_2_btn_button_negative"
            android:layout_marginEnd="29dp"
            android:layout_marginStart="29dp"
            android:layout_marginTop="2dp"
            android:layout_gravity="start"
            android:layout_marginBottom="2dp"
            android:gravity="start"
            android:text="@string/recording_intro_km_body"
            android:textColor="@color/translucent_black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/recording_error_2_btn_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="29dp"
            android:layout_gravity="start"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:gravity="start"
            android:text="@string/i_need_help"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="parent"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/recording_error_2_btn_button_positive"
            style="@style/kardia_btn_primary"
            android:layout_width="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="29dp"
            app:layout_constraintBottom_toTopOf="@id/recording_error_2_btn_button_negative"
            android:layout_marginTop="@dimen/insights_margin_4"
            android:background="@drawable/bkg_btn_teal_gradient_corners_r20"
            tools:text="Go to Settings" />

        <TextView
            android:id="@+id/recording_error_2_btn_button_negative"
            android:layout_width="wrap_content"
            android:layout_gravity="center_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="32dp"
            android:layout_marginEnd="29dp"
            app:layout_constraintTop_toBottomOf="@id/recording_error_2_btn_button_positive"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/insights_margin_4"
            android:background="@drawable/bkg_btn_teal_gradient_corners_r20"
            style="@style/kardia_btn_primary"
            tools:text="Go to Settings"/>

</androidx.constraintlayout.widget.ConstraintLayout>

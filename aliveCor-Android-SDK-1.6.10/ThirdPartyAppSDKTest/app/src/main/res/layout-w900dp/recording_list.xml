<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:baselineAligned="false"
    android:divider="?android:attr/dividerHorizontal"
    android:orientation="horizontal"
    android:showDividers="middle"
    tools:context=".RecordingListActivity">

    <!--
    This layout is a two-pane layout for the Recordings master/detail flow.
    -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recording_list"
        android:name="com.alivecor.testapp.RecordingListFragment"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layoutManager="LinearLayoutManager"
        tools:context="com.alivecor.testapp.RecordingListActivity"
        tools:listitem="@layout/recording_list_content" />

    <FrameLayout
        android:id="@+id/recording_detail_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3" />

</LinearLayout>